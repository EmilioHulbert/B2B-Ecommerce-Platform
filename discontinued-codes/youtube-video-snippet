  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
  allowfullscreen
  style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; display: none;">
</iframe>

              </div>
                
              <script src="{% static 'brand/js/youtube-script.js' %}"></script>
               <link href="{% static 'brand/js/youtube-position.css' %}" rel="stylesheet">

              <div class="p-3">
                <h5 class="mb-2">How ERP Systems Work</h5>
                <p class="small text-muted">
                  Understand how ERP integrates operations, boosts efficiency, and streamlines business processes.
                </p>
              </div>
            </div>
          </div>
