i<!-- Third column: YouTube video -->
<div class="col-12 col-sm-12 col-md-12 col-lg-4">
            <div class="card shadow h-100 d-flex flex-column justify-content-between">
              <div id="youtube-container" style="position: relative; width: 100%; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px; background: #f0f0f0;">
                <div id="youtube-loader" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center;">
                  <div style="border: 4px solid #f3f3f3; border-top: 4px solid #3498db; border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin: 0 auto;"></div>
                  <p style="margin-top: 10px; color: #666;">Loading video...</p>
                </div>
                <noscript>
                  <p>To view this video, please enable JavaScript, or <a href="https://www.youtube.com/watch?v=zI2eCVrUTvU" target="_blank">watch it on YouTube</a>.</p>
                </noscript>

