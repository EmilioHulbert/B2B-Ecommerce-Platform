  <section id="home" class="home">
      <!-- <h1>Your Challenge</h1> -->
      <!-- <h2>Our Solution</h2> -->
    <div class="wave wave1"></div>
    <div class="wave wave2"></div>
    <div class="wave wave3"></div>
  </section>

 <section id="about" class="about">
  <h1 class="heading">about us</h1>
  <div class="row">
    <div class="content">
      <p>
        NashTech Solutions is a multi-disciplinary technology company that combines strategy,
        innovation, and execution to help businesses thrive in the digital age.
      </p>

      <button class="btn" onclick="toggleAboutPopup()">Read More</button>
    </div>
  </div>

  <!-- Hidden Full About Popup -->
  <div id="about-popup" class="about-popup hidden">
    <!-- <div class="about-popup-overlay"> added for external close functionality -->
    <div class="about-popup-content">
      <span class="close-btn" onclick="toggleAboutPopup()">&times;</span>
      <p>
        Backed by a diverse and skilled team, NashTech Solutions is committed to empowering clients
        through cutting-edge technology, strategic innovation, and end-to-end digital support.<br><br>

        Whether helping a startup build its first app, deploying ERP systems for industrial clients,
        or providing corporate tech training, NashTech is driven by the mission to deliver dynamic,
        tailored, and scalable tech-driven solutions that empower people, automate systems, and spark
        growth across all sectors — bridging business goals with innovative tech.

        
        NashTech Solutions is a forward-thinking, full-service technology solutions company
        that delivers innovative digital transformation services to businesses of all sizes.
        Originally established in 2016 as a small team of passionate tech enthusiasts,NashTech
        began by offering freelance software development, hardware sales and IT support services.
        Over the years, the team steadily built a reputation for reliability, innovation, and customer-centric
        solutions, serving SMEs, startups, and corporates across multiple industries.In response to growing
        demand and a broader vision, NashTech was officially incorporated in 2021, marking a significant milestone
        in its evolution from a small operation into a fully structured and scalable technology company.The incorporation 
        enabled NashTech to expand its service portfolio, formalize its operations, and position itself as 
        a trusted digital partner for organizations looking to thrive in an increasingly tech-driven world.

        
      </p>
    </div>
    <!-- </div> -->
  </div>
</section>
<script src="{% static 'brand/js/about-section.js' %}"></script>


<div class="pt-5 pb-5" style="background-color: #f2f2f2;">
 <div class="container-fluid"><!--can be cont fluid-->
      <div class="section-head col-sm-12" id="service">
        <h1>Our Services</h1>
        <p>
          We help you build high-quality digital solutions and deliver a wide range of related professional services.
          We are providing world-class service to our clients.
        </p>
      </div>
  
      <!-- Start Grid -->
      <div class="row" style="background-image: url('/static/images/ims-bg.jpeg'); background-size: cover; background-position: center; color: white;">
        <!-- First column: 2 cards -->
        <div class="col-md-4">
          <!-- <div class="item mb-4"> -->
            <!-- <div class="item mb-4 service-card" data-id="{{ service.id }}"> -->
                <div class="item mb-4 service-card" data-category="Information Management Systems">
                    <span class="icon"><i class="fa fa-server"></i></span>
                    <h6>Information Management Systems</h6>
                    <p>Centralized data management for enterprise operations.</p>
                  </div>
                  
                   <!-- <div class="item mb-4 service-card" data-category="Information Management Systems" style="background-image: url('/static/images/ims-bg.jpeg'); background-size: cover; background-position: center; color: white;">
                    <div class="p-4" style="background: rgba(0, 0, 0, 0.5); border-radius: 10px;">
                      <h6 style="color: #fff;">Information Management Systems</h6>
                      <p>Centralized data management for enterprise operations.</p>
                    </div>
                  </div> -->

<!-- <div class="item mb-4"> -->
            <div class="item mb-4 service-card" data-category="Digital Marketing & Branding">
            <span class="icon feature_box_col_two"><i class="fa fa-bullhorn"></i></span>
            <h6>Digital Marketing & Branding</h6>
            <p>Promoting products and building brand presence across online channels.</p>
          </div>
        </div> <!-- here-->
        <!-- Second column: 2 cards -->
        <div class="col-md-4">
          <!-- <div class="item mb-4"> -->
            <div class="item mb-4 service-card" data-category="Hardware & IT Infrastructure">
            <span class="icon feature_box_col_three"><i class="fa fa-magic"></i></span>
            <h6>Hardware & IT Infrastructure</h6>
            <p>The foundational physical and digital backbone supporting an organization's technology.</p>
          </div>
          <!-- <div class="item mb-4"> -->
            <div class="item mb-4 service-card" data-category="Creative Media">
            <span class="icon feature_box_col_one"><i class="fa fa-code"></i></span>
            <h6>Creative Media</h6>
            <p>Crafting compelling visual and audio content for diverse platforms and storytelling.</p>
          </div>
        </div>
  
        <!-- Third column: 2 cards -->
        <div class="col-md-4">
            <div class="card shadow h-100 d-flex flex-column justify-content-between">
              <div style="position: relative; width: 100%; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px;">
                <noscript>
                  <p>To view this video, please enable JavaScript, or <a href="https://www.youtube.com/watch?v=zI2eCVrUTvU" target="_blank">watch it on YouTube</a>.</p>
                </noscript>
                
                <iframe
                  loading="lazy"
                  src="https://www.youtube.com/embed/zI2eCVrUTvU"
                  title="What is ERP?"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none;">
                </iframe>
              </div>
              <script>
                document.addEventListener("DOMContentLoaded", () => {
                  const ytFrame = document.querySelector('iframe[src*="youtube"]');
                  if (!ytFrame) return;
              
                  setTimeout(() => {
                    if (!ytFrame.contentWindow || ytFrame.clientHeight === 0) {
                      console.warn("⚠️ YouTube failed to load. Displaying fallback.");
                      ytFrame.insertAdjacentHTML("afterend", `
                        <div style="color:red; padding:1rem;">
                          YouTube video failed to load. <a href="https://www.youtube.com/watch?v=zI2eCVrUTvU" target="_blank">Watch on YouTube</a>.
                        </div>
                      `);
                    }
                  }, 3000); // wait 3s
                });
              </script>
              
              <div class="p-3">
                <h5 class="mb-2">How ERP Systems Work</h5>
                <p class="small text-muted">
                  Understand how ERP integrates operations, boosts efficiency, and streamlines business processes.
                </p>
              </div>
            </div>
          </div>
          
  
        <!-- Last row: remaining 2 cards full-width below -->
        <div class="col-md-6 mt-4">
          <!-- <div class="item"> -->
            <div class="item mb-4 service-card" data-category="Bootcamp & Skills Training">
                <span class="icon feature_box_col_one"><i class="fa fa-laptop-code"></i></span>
            <h6>Bootcamp & Skills Training</h6>
            <p>Intensive, practical programs for rapid acquisition of in-demand career skills.</p>
          </div>
        </div>
  
        <div class="col-md-6 mt-4">
          <!-- <div class="item"> -->
            <div class="item mb-4 service-card" data-category="Information Management Systems">
            <span class="icon feature_box_col_one"><i class="fa fa-th-large"></i></span>
            <h6>All Tech categories</h6>
            <p>End-to-end IT hardware, cloud, and networking solutions for scalable growth.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  

<!-- Modal -->
<div class="modal fade" id="serviceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="serviceTitle">Category Title</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="row" id="categoryServicesContainer">
            <!-- Service cards will be injected here -->
          </div>
        </div>
      </div>
    </div>
  </div>
<!--second modal-->
  <div class="modal fade" id="serviceDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="serviceDetailTitle"></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p id="serviceDetailDesc" class="mb-4"></p>
          <div id="serviceDetailCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner" id="serviceDetailCarouselInner"></div>
            <button class="carousel-control-prev" type="button" data-bs-target="#serviceDetailCarousel" data-bs-slide="prev">
              <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#serviceDetailCarousel" data-bs-slide="next">
              <span class="carousel-control-next-icon"></span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  

