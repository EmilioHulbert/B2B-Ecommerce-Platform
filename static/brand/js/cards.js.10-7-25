document.addEventListener("DOMContentLoaded", () => {
  console.log("✅ JS loaded");

  const services = JSON.parse(document.getElementById("service-json").textContent);

  document.querySelectorAll(".service-card").forEach(card => {
    card.addEventListener("click", () => {
      const cardTitle = card.querySelector("h6").textContent.trim();

      // Find all services in this category
      const matchingServices = services.filter(s => s.category === cardTitle);

      if (!matchingServices.length) return;

      // Set modal title to category
      document.getElementById("serviceTitle").textContent = cardTitle;

      // Clear old content
      const container = document.getElementById("categoryServicesContainer");
      container.innerHTML = "";

      // Create service cards
      matchingServices.forEach(service => {
        const col = document.createElement("div");
        col.className = "col-md-6 mb-4";

        col.innerHTML = `
          <div class="card shadow-sm h-100">
            ${service.images[0] ? `<img src="${service.images[0]}" class="card-img-top rounded-top" alt="${service.name}">` : ''}
            <div class="card-body">
              <h5 class="card-title">${service.name}</h5>
              <p class="card-text">${service.description.substring(0, 100)}...</p>
            </div>
          </div>
        `;

        container.appendChild(col);
      });

      // Show modal
      const modalEl = document.getElementById("serviceModal");
      const modal = new bootstrap.Modal(modalEl);
      modal.show();
    });
  });
});

